<?xml version="1.0" encoding="UTF-8"?>
<!-- Raven SD Gallery: vivid, high-contrast controls for an 800x480 HMI. -->
<Window Title="Raven SD Gallery" Width="800" Height="480" MinWidth="800" MinHeight="480">
    <Overlay>
    <Border Name="gallery" Background="#000000" Slot.Fill="1">
    <VBox>
        <HBox Height="68" Spacing="12" Slot.Padding="18,14,18,10">
            <Border Background="#E53935" BorderColor="#FFFFFF" BorderWidth="1" CornerRadius="12" Width="42" Height="42" Slot.VAlign="Center">
                <Label Text="SD" TextSize="14" Color="#FFFFFF" Slot.HAlign="Center" Slot.VAlign="Center"/>
            </Border>
            <VBox Spacing="1" Slot.VAlign="Center">
                <Label Text="Raven Gallery" TextSize="22" Color="#FFFFFF"/>
                <Label Text="MicroSD BMP viewer" TextSize="12" Color="#00BFA5"/>
            </VBox>
            <Border Background="#1565C0" CornerRadius="8" Width="5" Height="42" Slot.VAlign="Center"/>
            <Spacer Slot.Fill="1"/>
            <Border Background="#FDD835" BorderColor="#FFFFFF" BorderWidth="1" CornerRadius="100" Padding="12,5" Slot.VAlign="Center">
                <Label Name="count" Text="CARD OFFLINE" TextSize="11" Color="#000000"/>
            </Border>
            <Button Name="rescan" Text="Rescan" Style="Primary" Slot.VAlign="Center"/>
        </HBox>

        <HBox Spacing="14" Slot.Fill="1" Slot.Padding="18,4,18,10">
            <Border Background="#101010" BorderColor="#FF00FF" BorderWidth="2" CornerRadius="16" Padding="12" Width="242">
                <VBox Spacing="8">
                    <HBox>
                        <Label Text="IMAGE LIBRARY" TextSize="12" Color="#FF00FF" Slot.Fill="1" Slot.VAlign="Center"/>
                        <Label Text=".BMP" TextSize="11" Color="#FDD835" Slot.VAlign="Center"/>
                    </HBox>
                    <Separator/>
                    <ListView Name="files" Slot.Fill="1"/>
                    <Label Text="Tap any file to load it" TextSize="11" Color="#00BFA5"/>
                    <Border Background="#E53935" CornerRadius="8">
                        <Button Name="open" Text="Open selected" Style="Flat"/>
                    </Border>
                    <Border Background="#00C853" CornerRadius="8">
                        <Button Name="slideshow" Text="Play slideshow" Style="Flat"/>
                    </Border>
                </VBox>
            </Border>

            <VBox Spacing="10" Slot.Fill="1">
                <Border Background="#101010" BorderColor="#00BFA5" BorderWidth="2" CornerRadius="16" Padding="12" Slot.Fill="1">
                    <VBox Spacing="9">
                        <HBox>
                            <VBox Spacing="1" Slot.Fill="1">
                                <Label Text="PREVIEW" TextSize="12" Color="#1565C0"/>
                                <Label Name="selected" Text="Choose a BMP from the library" TextSize="17" Color="#FFFFFF"/>
                            </VBox>
                            <Border Background="#00C853" BorderColor="#FFFFFF" BorderWidth="1" CornerRadius="100" Padding="10,4" Slot.VAlign="Center">
                                <Label Text="24-BIT" TextSize="10" Color="#000000"/>
                            </Border>
                        </HBox>
                        <Border Background="#000000" BorderColor="#1565C0" BorderWidth="2" CornerRadius="12" Clip="true" Slot.Fill="1">
                            <Image Name="preview" Stretch="Fit" Slot.Fill="1"/>
                        </Border>
                    </VBox>
                </Border>
                <Border Background="#003D3A" BorderColor="#FDD835" BorderWidth="1" CornerRadius="12" Padding="12,8">
                    <Label Name="status" Text="Insert a microSD card to begin." TextSize="12" Color="#FFFFFF" Wrap="true"/>
                </Border>
            </VBox>
        </HBox>

        <HBox Height="28" Slot.Padding="20,0,20,8">
            <Label Text="800 x 480  •  FAT/FAT32  •  Root folder  •  24-bit BMP" TextSize="10" Color="#00BFA5" Slot.VAlign="Center"/>
            <Spacer Slot.Fill="1"/>
            <Label Text="ELECROW ESP32-S3" TextSize="10" Color="#FF00FF" Slot.VAlign="Center"/>
        </HBox>
    </VBox>
    </Border>
    <!-- This is intentionally the only widget visible during playback: every
         valid gallery image is already 800 x 480, so it fills the panel. -->
    <Image Name="slideshow_view" Stretch="Fit" Visibility="Collapsed" Slot.Fill="1"/>
    </Overlay>
</Window>
